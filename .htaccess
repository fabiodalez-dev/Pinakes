RewriteEngine On

# Block access to sensitive files at root level
<FilesMatch "^(\.env|\.env\..+|\.git.*|\.installed|composer\.(json|lock)|package(-lock)?\.json|CLAUDE\.md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Prevent directory browsing
Options -Indexes

# Exclude the installer and the manual-upgrade script from the rewrite (allow
# direct access). Anchored, directory-relative patterns: in .htaccess context
# they are matched against the path INCLUDING PATH_INFO, so an "installer"
# segment appended to another file (/scripts/maintenance.php/installer) cannot
# satisfy them.
RewriteRule ^installer(/|$) - [NC,L]
RewriteRule ^scripts/manual-upgrade\.php$ - [NC,L]

# Redirect everything else to /public/. This includes the legacy calendar URL
# /storage/calendar/library-calendar.ics: the app answers it (like
# /calendar/events.ics), so private mode applies to it.
RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^(.*)$ public/$1 [L,QSA]
