<IfModule mod_rewrite.c>
    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # === Pinakes LiteSpeed privacy bypass ===
    # Prevent LiteSpeed from serving a shared cache entry before PHP can apply
    # its user/session checks. A sole locale cookie is safe because the
    # application varies public pages on pinakes_locale.
    <IfModule LiteSpeed>
        RewriteRule .* - [E=Cache-Vary:pinakes_locale]

        RewriteCond %{REQUEST_METHOD} !^(GET|HEAD)$ [NC]
        RewriteRule .* - [E=Cache-Control:no-cache]

        RewriteCond %{HTTP:Authorization} .
        RewriteRule .* - [E=Cache-Control:no-cache]

        RewriteCond %{HTTP:Cookie} !^$
        RewriteCond %{HTTP:Cookie} !^\s*pinakes_locale=[A-Za-z]{2}_[A-Za-z]{2}\s*;?\s*$ [NC]
        RewriteRule .* - [E=Cache-Control:no-cache]
    </IfModule>
    # === end Pinakes LiteSpeed privacy bypass ===

    # PRIVATE uploaded content (digital-library files, archive documents,
    # generic storage) must go through index.php so PrivateModeMiddleware gates
    # it — never serve it directly. Relative pattern is subdirectory-safe.
    RewriteRule ^uploads/(digital|archives/documents|storage)/ index.php [QSA,L]

    # Allow direct access to the remaining PUBLIC static files in /uploads/.
    RewriteRule ^uploads/ - [L]

    # Redirect all requests to index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Security Headers
<IfModule mod_headers.c>
    # Prevent MIME-type sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Enable XSS protection
    Header always set X-XSS-Protection "1; mode=block"

    # Prevent clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"

    # Content Security Policy - restrictive but allows inline styles/scripts for compatibility
    # Allows Google Fonts for Inter font family
    # Content-Security-Policy is emitted by the application with a unique nonce.

    # Referrer policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Block access to sensitive files (defense in depth)
# Even though these files are outside webroot, this prevents misconfiguration attacks
<FilesMatch "^(\.env|\.env\..+|\.git.*|\.htaccess|composer\.(json|lock)|package(-lock)?\.json|\.installed|version\.json|CLAUDE\.md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Audio/Video Streaming Support (for Digital Library plugin)
<IfModule mod_headers.c>
    # Enable Range Requests for audio/video streaming
    # Required for seek functionality in audio players
    <FilesMatch "\.(mp3|m4a|ogg|wav|mp4|webm|ogv)$">
        Header set Accept-Ranges bytes
        # Allow CORS for audio/video files (required for cross-origin playback)
        Header set Access-Control-Allow-Origin "*"
        Header set Access-Control-Allow-Methods "GET, OPTIONS"
        Header set Access-Control-Allow-Headers "Range, Content-Type"
        Header set Access-Control-Expose-Headers "Content-Length, Content-Range, Accept-Ranges"
    </FilesMatch>

    # CORS for digital content in uploads/digital/ directory
    <If "%{REQUEST_URI} =~ m#^/uploads/digital/#">
        Header set Access-Control-Allow-Origin "*"
        Header set Access-Control-Allow-Methods "GET, OPTIONS"
    </If>
</IfModule>

# Correct MIME types for audio files
<IfModule mod_mime.c>
    AddType audio/mpeg .mp3
    AddType audio/mp4 .m4a
    AddType audio/ogg .ogg
    AddType audio/wav .wav
    AddType audio/webm .weba
    AddType video/mp4 .mp4
    AddType video/webm .webm
    AddType video/ogg .ogv
    AddType application/pdf .pdf
    AddType application/epub+zip .epub
</IfModule>
